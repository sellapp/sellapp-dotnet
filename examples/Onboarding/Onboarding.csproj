<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RestoreAdditionalProjectSources>$(SellAppPackageDirectory)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SellApp.net/SellApp.net.csproj" Condition="'$(SellAppPackageDirectory)' == ''" />
    <PackageReference Include="SellApp" Version="0.1.0" Condition="'$(SellAppPackageDirectory)' != ''" />
  </ItemGroup>
</Project>
